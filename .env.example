# Skopírujte do .env.local a vyplňte

# Heslo do administrácie (prihlásenie na /admin)
ADMIN_PASSWORD=zmen-toto-heslo

# Tajný kľúč pre session cookies (min. 32 znakov, náhodný reťazec)
SESSION_SECRET=nahodny-retazec-aspon-32-znakov-dlhy!!

# Verejná URL stránky (používa sa v e-mailoch)
SITE_URL=http://localhost:3000

# SMTP nastavenia pre odosielanie e-mailov odberateľom
# (funguje s Websupport, Gmail app-password, Resend SMTP, atď.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Farnosť Lokca <farnost@rkclokca.sk>"
